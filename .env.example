# Copy to .env only if you prefer to manage local values yourself.
# `npm run dev:docker` creates .env with separate random local database passwords when absent.
POSTGRES_DB=plutoshop
POSTGRES_USER=pluto
POSTGRES_PASSWORD=replace-with-a-long-random-owner-secret
POSTGRES_APP_PASSWORD=replace-with-a-different-long-random-app-secret
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-keycloak-secret
AUTH_SESSION_SECRET=replace-with-64-hex-character-session-secret
OIDC_ISSUER=http://127.0.0.1:8081/realms/pluto
OIDC_INTERNAL_ISSUER=http://keycloak:8080/realms/pluto
OIDC_CLIENT_ID=pluto-web
OIDC_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback
WEB_PORT=3000
