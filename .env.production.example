# Production values for compose.production.yaml.
# Copy this file to .env.production on the VPS and replace every placeholder.
# Keep .env.production outside Git and make it readable only by the deploy user.

SHOP_DOMAIN=shop.example.com
AUTH_DOMAIN=auth.example.com
ACME_EMAIL=ops@example.com

# Immutable images built by GitHub Actions and pulled by their commit SHA.
IMAGE_NAMESPACE=ghcr.io/your-org/pluto-shop
IMAGE_TAG=replace-with-github-commit-sha
GHCR_USERNAME=replace-with-github-username
GHCR_TOKEN=replace-with-read-packages-token

POSTGRES_DB=plutoshop
POSTGRES_USER=pluto
POSTGRES_PASSWORD=replace-with-long-random-owner-secret
POSTGRES_APP_PASSWORD=replace-with-different-long-random-app-secret
POSTGRES_WRITE_PASSWORD=replace-with-different-long-random-write-secret
POSTGRES_ADMIN_PASSWORD=replace-with-different-long-random-admin-secret
POSTGRES_INSPECTOR_PASSWORD=replace-with-different-long-random-inspector-secret

KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-different-long-random-keycloak-db-secret
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-different-long-random-keycloak-admin-secret
KEYCLOAK_REALM_FILE=./infra/production/runtime/realm-production.json

AUTH_SESSION_SECRET=replace-with-64-hex-character-session-secret
OIDC_CLIENT_ID=pluto-web
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_AUDIENCE=pluto-api

FULFILLMENT_SECURITY_ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64url-key
FULFILLMENT_SECURITY_FINGERPRINT_KEY_BASE64=replace-with-different-32-byte-base64url-key
FULFILLMENT_SECURITY_KEY_VERSION=1
FULFILLMENT_DELIVERY_ENABLED=true
INWCLOUD_API_BASE_URL=https://api.inwcloud.shop
INWCLOUD_API_KEY=replace-with-payment-provider-key

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=no-reply@example.com
SMTP_FROM_DISPLAY_NAME="Pluto Shop"
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password

# Restic repository and S3-compatible object storage.
RESTIC_REPOSITORY=s3:https://s3.example.com/pluto-shop
RESTIC_PASSWORD=replace-with-long-random-restic-repository-password
AWS_ACCESS_KEY_ID=replace-with-backup-access-key
AWS_SECRET_ACCESS_KEY=replace-with-backup-secret-key
AWS_DEFAULT_REGION=us-east-1

# Alerting and dead-man switch URLs. Leave empty until the endpoints exist.
ALERT_WEBHOOK_URL=
BACKUP_DEAD_MAN_URL=
