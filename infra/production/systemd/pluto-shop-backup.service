[Unit]
Description=Pluto Shop encrypted production backup
Wants=network-online.target
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=pluto
SupplementaryGroups=docker
WorkingDirectory=/opt/pluto-shop/current
Environment=ENV_FILE=/opt/pluto-shop/current/.env.production
ExecStart=/usr/bin/env bash /opt/pluto-shop/current/infra/production/backup-production.sh
TimeoutStartSec=1h
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pluto-shop/current/infra/production/runtime /tmp
